{
  "info": {
    "name": "User Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Запустите сервис с PostgreSQL и применёнными миграциями. Импортируйте коллекцию и запустите все запросы по порядку через Run collection. base_url по умолчанию http://localhost:8080, без /api/v1 для прямого обращения к сервису. Каждый полный запуск создаёт нового тестового пользователя; пользователь остаётся в БД. Токены сохраняются автоматически. Только текущие реализованные функции: регистрация, вход, профиль, refresh. Перед каждым запросом тестовые данные и токены копируются из переменных коллекции в локальные, чтобы environment и data не переопределяли их. Запускайте всю коллекцию с первого запроса по порядку. Запросы 13–18 проверяют выход только с первого устройства, отзыв access/refresh и сохранение доступа на втором."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "password",
      "value": "TestPass123!"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "old_refresh_token",
      "value": ""
    },
    {
      "key": "second_access_token",
      "value": ""
    },
    {
      "key": "second_refresh_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 — Регистрация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 20);",
              "pm.collectionVariables.set(\"email\", \"test_\" + suffix + \"@example.com\");",
              "pm.collectionVariables.set(\"username\", \"test_\" + suffix);",
              "[\"user_id\", \"access_token\", \"refresh_token\", \"old_refresh_token\"].forEach(function (key) {",
              "    pm.collectionVariables.set(key, \"\");",
              "});",
              "[\"email\", \"username\", \"password\", \"user_id\", \"access_token\", \"refresh_token\", \"old_refresh_token\"].forEach(function (key) {",
              "    pm.variables.set(key, pm.collectionVariables.get(key));",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Получен user_id\", function () {",
              "    pm.expect(pm.response.json().user_id).to.be.a(\"string\").and.not.empty;",
              "});",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set(\"user_id\", pm.response.json().user_id);",
              "}"
            ]
          }
        }
      ]
    },
